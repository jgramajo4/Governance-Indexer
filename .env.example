# Copy to .env for local Docker/Compose orchestration; replace placeholders locally.
DATABASE_URL=postgres://gavel_indexer:replace-me@localhost:5432/governance_indexer
ETHEREUM_RPC_URL=
PUBLIC_SOURCE_ENDPOINT=
INDEXER_ENABLED_DAOS=nouns,ens
INDEXER_CONFIRMATION_DEPTH=64
INDEXER_BLOCK_BATCH_SIZE=5000
INDEXER_RPC_CONCURRENCY=4
INDEXER_DB_POOL_SIZE=10
INDEXER_FULL_SCAN_INTERVAL_SECONDS=21600
INDEXER_WARM_REFRESH_SECONDS=900
INDEXER_MAX_CHECKPOINT_AGE_SECONDS=900
GAVEL_INDEXER_DB_PASSWORD=replace-me
GAVEL_API_DB_PASSWORD=replace-me
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
