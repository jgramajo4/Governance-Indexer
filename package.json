{
  "name": "governance-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone PostgreSQL governance indexer and read-only API for Nouns, ENS, and Railgun.",
  "license": "GPL-3.0-only",
  "engines": { "node": ">=20" },
  "main": "src/index.js",
  "bin": { "governance-indexer": "bin/gavel-indexer.js" },
  "scripts": {
    "indexer": "node bin/gavel-indexer.js",
    "test": "node --test test/*.test.js",
    "test:postgres": "GOVERNANCE_INDEXER_TEST_DATABASE_URL=${GOVERNANCE_INDEXER_TEST_DATABASE_URL:-$GAVEL_TEST_DATABASE_URL} node --test test/governance-index-postgres.test.js test/nouns-candidate-postgres.test.js",
    "test:domain": "node --test test/domain-characterization.test.js",
    "check": "git diff --check"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  }
}
